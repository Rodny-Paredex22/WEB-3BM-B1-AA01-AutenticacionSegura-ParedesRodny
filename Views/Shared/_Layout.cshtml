<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MagnaTaller</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-magna">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Cuenta" asp-action="Login">
                    MAGNA<span>TALLER</span>
                </a>
                <div class="navbar-nav ms-auto align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-link text-light" asp-controller="Cuenta" asp-action="Perfil">Mi Perfil</a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a class="nav-link text-warning fw-semibold" asp-controller="Admin" asp-action="Usuarios">Panel Admin</a>
                        }
                        <span class="badge bg-secondary">@User.Identity.Name</span>
                        <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-light">Cerrar Sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link text-light" asp-controller="Cuenta" asp-action="Login">Iniciar Sesión</a>
                        <a class="btn btn-sm btn-magna" asp-controller="Cuenta" asp-action="Registro">Registrarse</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }
        @if (TempData["MensajeInfo"] != null)
        {
            <div class="alert alert-info">@TempData["MensajeInfo"]</div>
        }

        @RenderBody()
    </main>

    <footer class="py-3 text-center small">
        <div class="container">
            MagnaTaller - Módulo de Autenticación y Seguridad (AA01)
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            // Alterna la visibilidad de un campo de contraseña dentro de un input-group
            function alternarContrasena(boton) {
                const input = boton.closest('.input-group')?.querySelector('input');
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
            }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

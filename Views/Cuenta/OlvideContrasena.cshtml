@model OlvideContrasenaViewModel
@{
    ViewData["Title"] = "Olvidé mi Contraseña";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm card-magna">
            <div class="card-body p-4">
                <h3 class="card-title mb-3">Recuperar Contraseña</h3>
                <p class="text-muted small mb-4">Ingresa tu correo registrado para recibir un enlace de restablecimiento.</p>

                <form asp-controller="Cuenta" asp-action="OlvideContrasena" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-magna w-100">Enviar Enlace de Recuperación</button>
                </form>

                <div class="mt-3 text-center small">
                    <a asp-action="Login">Volver al inicio de sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>

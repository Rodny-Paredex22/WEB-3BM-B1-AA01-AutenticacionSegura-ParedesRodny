@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm card-magna">
            <div class="card-body p-4">
                <h3 class="card-title mb-3">Iniciar Sesión</h3>
                <p class="text-muted small mb-4">Ingresa tus credenciales para acceder a MagnaTaller.</p>

                <form asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-magna w-100">Ingresar</button>
                </form>

                <div class="mt-3 text-center small">
                    <a asp-action="OlvideContrasena" class="text-decoration-none d-block mb-1">¿Olvidaste tu contraseña?</a>
                    <span>¿No tienes cuenta? <a asp-action="Registro" class="fw-semibold">Regístrate aquí</a></span>
                </div>
            </div>
        </div>
    </div>
</div>

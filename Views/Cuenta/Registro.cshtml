@model RegistroViewModel
@{
    ViewData["Title"] = "Registro de Cliente";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm card-magna">
            <div class="card-body p-4">
                <h3 class="card-title mb-3">Crear Cuenta</h3>
                <p class="text-muted small mb-4">Regístrate como cliente de MagnaTaller.</p>

                <form asp-controller="Cuenta" asp-action="Registro" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <input asp-for="NombreCompleto" class="form-control" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" />
                            <button type="button" class="btn btn-outline-secondary" onclick="alternarContrasena(this)" title="Mostrar u ocultar contraseña" aria-label="Mostrar u ocultar contraseña">●</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmarPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="ConfirmarPassword" class="form-control" />
                            <button type="button" class="btn btn-outline-secondary" onclick="alternarContrasena(this)" title="Mostrar u ocultar contraseña" aria-label="Mostrar u ocultar contraseña">●</button>
                        </div>
                        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                    </div>  

                    <button type="submit" class="btn btn-magna w-100">Registrarse</button>
                </form>

                <div class="mt-3 text-center small">
                    ¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>
